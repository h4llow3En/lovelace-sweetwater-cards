# Copy this file to .env.local and fill in your values.
# Used by: npm run dev:ha

# SSH destination for rsync — user@host or just host if SSH config handles auth
HA_HOST=user@homeassistant.local

# Absolute path on the HA host where www/ files live
HA_PATH=/config/www

# Full base URL of your HA instance (for the reload call)
HA_URL=http://homeassistant.local:8123

# Long-lived access token (Profile → Security → Long-Lived Access Tokens)
HA_TOKEN=your_token_here
